{
  "include": [
    "backend"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "backend/venv"
  ],
  "pythonVersion": "3.9",
  "pythonPlatform": "Darwin",
  "venvPath": "backend",
  "venv": "venv",
  "extraPaths": [
    "backend",
    "backend/app",
    "backend/venv/lib/python3.9/site-packages"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "extraPaths": [
        "backend",
        "backend/app",
        "backend/venv/lib/python3.9/site-packages"
      ]
    }
  ],
  "reportMissingImports": "none",
  "reportMissingTypeStubs": false
}
