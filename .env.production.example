# JobCopilot production environment — copy to `.env.production` and fill in.
# NEVER commit the filled-in file. `.env.production` is gitignored.
#
# Used by: docker compose --env-file .env.production -f docker-compose.production.yml up -d

# --- Postgres (the api/worker build DATABASE_URL from these) ---
POSTGRES_USER=jobcopilot
POSTGRES_PASSWORD=            # REQUIRED — strong random password
POSTGRES_DB=jobcopilot

# --- Application secrets (fail-closed: the API refuses to boot in prod without these) ---
JWT_SECRET=                   # REQUIRED — >= 32 chars, cryptographically random
JOBCOPILOT_MASTER_KEY=        # REQUIRED — AES envelope key for the credential vault
GOOGLE_OAUTH_CLIENT_ID=       # REQUIRED — the only production sign-in path (P0-2)

# --- Conditionally required (enforced by settings.py fail-closed validation when used) ---
# STORAGE_BACKEND=s3 -> S3_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# DEFAULT_LLM_PROVIDER=openai    -> OPENAI_API_KEY
# DEFAULT_LLM_PROVIDER=anthropic -> ANTHROPIC_API_KEY
# USE_CELERY=true                -> a non-localhost REDIS_URL
# STRIPE_SECRET_KEY set          -> STRIPE_WEBHOOK_SECRET must also be set
