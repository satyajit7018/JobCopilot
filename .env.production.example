# ==============================================================================
# JobCopilot OS — Production Environment Configuration Template
# Copy this file to .env.production or export these variables in your cloud runner.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
ENV=production
APP_PORT=8000
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 2. DATABASE BACKEND (SQLite or PostgreSQL)
# ------------------------------------------------------------------------------
# Options: 'sqlite' | 'postgres'
DB_MODE=sqlite

# If DB_MODE=postgres:
DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED TASK RUNNER & REDIS (Celery)
# ------------------------------------------------------------------------------
USE_CELERY=true
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 4. MULTI-TENANT CLOUD OBJECT STORAGE (S3 / Cloudflare R2 / Local)
# ------------------------------------------------------------------------------
# Options: 'local' | 's3' | 'r2'
STORAGE_BACKEND=local

# AWS S3 Settings (if STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=jobcopilot-production-resumes

# Cloudflare R2 Settings (if STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=jobcopilot-r2-resumes

# ------------------------------------------------------------------------------
# 5. RESIDENTIAL PROXY ROTATION (Bright Data / Oxylabs / Custom)
# ------------------------------------------------------------------------------
# Options: 'direct' | 'brightdata' | 'oxylabs' | 'custom'
PROXY_MODE=direct

# Bright Data Residential Credentials
BRIGHTDATA_CUSTOMER_ID=your_customer_id
BRIGHTDATA_ZONE=residential_us
BRIGHTDATA_PASSWORD=your_zone_password

# Oxylabs Credentials
OXYLABS_USERNAME=your_oxylabs_username
OXYLABS_PASSWORD=your_oxylabs_password

# ------------------------------------------------------------------------------
# 6. MONETIZATION & STRIPE BILLING
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Pricing Tiers
STRIPE_PRO_PRICE_ID=price_pro_monthly_29usd
STRIPE_ELITE_PRICE_ID=price_elite_monthly_79usd

# ------------------------------------------------------------------------------
# 7. RECRUITER EMAIL RADAR (IMAP Inbound Sync)
# ------------------------------------------------------------------------------
EMAIL_RADAR_ENABLED=true
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_inbox@gmail.com
IMAP_PASSWORD=your_app_password
